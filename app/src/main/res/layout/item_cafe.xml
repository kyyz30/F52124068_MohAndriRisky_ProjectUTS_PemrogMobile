<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgCafe"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:scaleType="centerCrop"
        android:src="@drawable/cafe_arobi"
        android:contentDescription="Foto cafe" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvNamaCafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Cafe"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvLokasiCafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lokasi Cafe"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvHargaCafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Harga"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvDeskripsiCafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi cafe"
            android:textSize="13sp"
            android:textColor="#444444"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>